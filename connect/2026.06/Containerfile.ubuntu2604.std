# Build Python using uv in a separate stage
FROM ghcr.io/astral-sh/uv:debian-slim AS python-builder

ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
ENV UV_PYTHON_INSTALL_DIR=/opt/python
ENV UV_PYTHON_PREFERENCE=only-managed
RUN uv python install 3.14.6
RUN mv /opt/python/cpython-3.14.6-linux-*/ /opt/python/3.14.6


FROM docker.io/library/ubuntu:26.04
LABEL org.opencontainers.image.base.name="docker.io/library/ubuntu:26.04"

### Global ARG declarations ###
ARG DEBIAN_FRONTEND=noninteractive
ARG BUILDARCH
ARG TARGETARCH=${BUILDARCH}

### Release ARG declarations ###
ARG BUILDARCH
ARG TARGETARCH=${BUILDARCH}
ARG RSTUDIO_INSTALL_NO_LICENSE_INITIALIZATION=1

### ENV declarations ###
ENV PCT_LICENSE=""
ENV PCT_LICENSE_SERVER=""
ENV PCT_LICENSE_FILE_PATH=""
ENV PCT_STARTUP_DEBUG=0

SHELL ["/bin/bash", "-euo", "pipefail", "-c"]

### Run setup ###
RUN echo 'Acquire::Retries "3"; Acquire::http::Timeout "30"; Acquire::https::Timeout "30";' > /etc/apt/apt.conf.d/99-retries && \
    apt-get update -yqq --fix-missing && \
    apt-get upgrade -yqq && \
    apt-get dist-upgrade -yqq && \
    apt-get autoremove -yqq --purge && \
    apt-get install -yqq --no-install-recommends \
        curl \
        ca-certificates \
        gnupg \
        tar && \
    bash -c "$(curl -1fsSL 'https://dl.posit.co/public/pro/setup.deb.sh')" && \
    apt-get clean -yqq && \
    rm -rf /var/lib/apt/lists/*

### Pin GNU coreutils (temporary workaround) ###
# Ubuntu 26.04 defaults to the Rust-based coreutils (uutils), which are not yet
# fully GNU-compatible and cause a defect in the Connect runtime. Pin GNU
# coreutils early so both the build and runtime use them. Revert once the
# runtime is compatible with uutils upstream.
# https://github.com/posit-dev/images-connect/issues/151
RUN apt-get update -yqq && \
    apt-get install -yqq coreutils-from-gnu --allow-remove-essential && \
    apt-get clean -yqq && \
    rm -rf /var/lib/apt/lists/*

### Update apt packages ###
COPY connect/2026.06/deps/ubuntu-26.04_packages.txt /tmp/ubuntu-26.04_packages.txt
COPY connect/2026.06/deps/ubuntu-26.04_optional_packages.txt /tmp/ubuntu-26.04_optional_packages.txt
RUN apt-get update -yqq && \
    xargs -a /tmp/ubuntu-26.04_packages.txt apt-get install -yqq --no-install-recommends && \
    xargs -a /tmp/ubuntu-26.04_optional_packages.txt apt-get install -yqq --no-install-recommends && \
    apt-get clean -yqq && \
    rm -rf /var/lib/apt/lists/*


### Install Pro Drivers ###
RUN apt-get update -yqq && \
    apt-get install -yqq --no-install-recommends \
        rstudio-drivers && \
    apt-get clean -yqq && \
    rm -rf /var/lib/apt/lists/*
RUN cp /opt/rstudio-drivers/odbcinst.ini.sample /etc/odbcinst.ini

### Install R ###
RUN RUN_UNATTENDED=1 R_VERSION=4.6.1 bash -c "$(curl -fsSL https://rstd.io/r-install)" && \
    find . -type f -name '[rR]-4.6.1.*\.(deb|rpm)' -delete

### Install Python ###
COPY --from=python-builder /opt/python /opt/python
RUN /opt/python/3.14.6/bin/pip install --no-cache-dir --upgrade --break-system-packages \
        pip \
        setuptools \
        virtualenv

### Install Quarto ###
RUN bash -c "$(curl -1fsSL 'https://dl.posit.co/public/open/setup.deb.sh')" && \
    apt-get install -yqq --no-install-recommends \
        quarto=1.9.38 && \
    apt-mark hold quarto && \
    apt-get clean -yqq && \
    rm -rf /var/lib/apt/lists/*

### Install TinyTex ###
# HOME="/opt" workaround: https://github.com/quarto-dev/quarto-cli/issues/11800
ADD https://github.com/rstudio/tinytex-releases/releases/latest /tmp/tinytex-release.json
RUN --mount=type=secret,id=github_token,required=false \
    GH_TOKEN="$([ -s /run/secrets/github_token ] && cat /run/secrets/github_token)" HOME="/opt" CI=true /opt/quarto/bin/quarto install tinytex --no-prompt --update-path && \
    rm -f /tmp/tinytex-release.json

### Install Connect ###
ARG CONNECT_VERSION="2026.06.1"
COPY connect/2026.06/conf/rstudio-connect.gcfg /tmp/rstudio-connect.gcfg
COPY --chmod=0775 connect/2026.06/scripts/install_connect.sh /tmp/install_connect.sh
RUN IMAGE_VARIANT="Standard" \
        /tmp/install_connect.sh && \
    sed -i 's/<CRAN_URL>/https:\/\/p3m.dev\/cran\/__linux__\/resolute\/latest/g' /etc/rstudio-connect/rstudio-connect.gcfg && \
    rm -f /tmp/install_connect.sh /tmp/rstudio-connect.gcfg

### Copy scripts ###
COPY --chmod=0775 connect/2026.06/scripts/startup.sh /usr/local/bin/startup.sh

### Create data volume ###
VOLUME ["/data"]

### Finalize image ###
EXPOSE 3939/tcp
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD curl --fail --silent --output /dev/null http://localhost:3939/__ping__
CMD ["/usr/local/bin/startup.sh"]
